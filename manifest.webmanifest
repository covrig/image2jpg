{
  "name": "IMAGE2JPG — Image Resizer, Converter",
  "short_name": "IMAGE2JPG",
  "description": "Resize, convert and share images entirely on your device. Works offline.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#000000",
  "theme_color": "#000000",
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        { "name": "images", "accept": ["image/*", ".heic", ".heif", ".hif", ".jpg", ".jpeg", ".png", ".webp", ".avif"] }
      ]
    }
  },
  "icons": [
    { "src": "./icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "./icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
